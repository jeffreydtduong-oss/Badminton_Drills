<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Drill Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Drill"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/currentDrillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drill #1 - Random Footwork"
            android:textSize="12sp"
            android:layout_marginBottom="24dp"
            android:textColor="#1976D2" />

        <!-- Drill 1 Settings -->
        <LinearLayout
            android:id="@+id/drill1Settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sections of the Court"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/minShuttleNumberEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/maxShuttleNumberEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:text="4"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg" />

            </LinearLayout>

            <!-- Time to Shuttle Section for Drill 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time to Shuttle (seconds)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/timeToShuttleMinEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="1.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/timeToShuttleMaxEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="3.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg" />

            </LinearLayout>

            <!-- Time to Center Section for Drill 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Back to Center (seconds)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/timeToCenterMinEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="1.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/timeToCenterMaxEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="2.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg" />

            </LinearLayout>

        </LinearLayout>

        <!-- Drill 2 Settings -->
        <LinearLayout
            android:id="@+id/drill2Settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shot Probabilities (Drill 2 Only)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Shuttle 1 & 2 Shot Probabilities -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shuttle 1 and 2 (Front Court)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Net Shot:"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/netProbEdit"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="50"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lift:"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/liftProbEdit"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="50"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Shuttle 3 & 4 Shot Probabilities -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shuttle 3 and 4 (Rear Court)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Drop Shot:"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/dropProbEdit"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="40"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear:"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/clearProbEdit"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="40"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Smash:"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/smashProbEdit"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="20"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Time to Shuttle Section for Drill 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time to Shuttle (seconds)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Front Court (Shuttle 1 & 2) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Front Court (Shuttle 1 &amp; 2)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/frontCourtTimeMinEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="1.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/frontCourtTimeMaxEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="2.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sec"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Back Court (Shuttle 3 & 4) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back Court (Shuttle 3 &amp; 4)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF5722"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/backCourtTimeMinEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="2.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max:"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/backCourtTimeMaxEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:text="3.0"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sec"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Shot-specific Time Back to Center Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Back to Center (seconds per shot)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Net Shot Time Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:background="#F5F5F5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Net Shot"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF5722"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/netTimeMinEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="1.0"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/netTimeMaxEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="1.5"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sec"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Lift Time Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:background="#F5F5F5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lift"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/liftTimeMinEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="1.5"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/liftTimeMaxEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="2.5"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sec"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Drop Shot Time Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:background="#F5F5F5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drop Shot"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2196F3"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/dropTimeMinEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="1.5"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/dropTimeMaxEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="2.0"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sec"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Clear Time Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:background="#F5F5F5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#9C27B0"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/clearTimeMinEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="2.0"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/clearTimeMaxEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="3.0"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sec"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Smash Time Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:padding="8dp"
                android:background="#F5F5F5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smash"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#F44336"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/smashTimeMinEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="2.0"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max:"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/smashTimeMaxEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="2.5"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@drawable/edit_text_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sec"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Number Display Time (Common to both drills) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number Display Time (seconds)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration:"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/numberDisplayTimeEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:text="0.5"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="@drawable/edit_text_bg" />

        </LinearLayout>

        <!-- TTS speed adjustment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Speed"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/speechRateSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="12" />  <!-- 12 = 1.2x speed -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slower"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/speechRateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2x"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faster"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rep Configuration Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rep Configuration"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/repModeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/infiniteRepsRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Don't stop (infinite reps)"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/fixedRepsRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Do for specified amount of reps:"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Reps:"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/targetRepsEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="10"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="@drawable/edit_text_bg" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>